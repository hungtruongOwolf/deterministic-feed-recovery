{
  "name": "dfr-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Reads a dfr trace and draws it. Contains no domain logic on purpose.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "esbuild scripts/check.tsx --bundle --platform=node --format=esm --jsx=automatic --outfile=node_modules/.cache/check.mjs --external:react --external:react-dom --log-level=warning && node node_modules/.cache/check.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.0",
    "vite": "^6.0.0"
  }
}

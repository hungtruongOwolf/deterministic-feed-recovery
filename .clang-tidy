# Checks are chosen to enforce docs/STYLE.md and docs/DESIGN.md, not to enable
# everything available. Each disabled check below has a reason.
Checks: >
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-avoid-do-while,
  -cppcoreguidelines-pro-type-vararg,
  -cppcoreguidelines-missing-std-forward,
  -misc-non-private-member-variables-in-classes,
  -misc-include-cleaner,
  -modernize-use-trailing-return-type,
  -readability-magic-numbers,
  -readability-identifier-length

# Rationale for the exclusions:
#
#   bugprone-easily-swappable-parameters
#     Wire decoders legitimately take several same-typed integers. The real
#     mitigation is TIGER_STYLE's "a function taking two u64 must use an
#     options struct", which is a review rule, not a lint.
#
#   cppcoreguidelines-avoid-magic-numbers, readability-magic-numbers
#     Protocol constants are magic numbers by nature. A MoldUDP64 header is 20
#     bytes because the spec says so. They are pinned by static_assert instead.
#
#   cppcoreguidelines-pro-type-reinterpret-cast
#     cppcoreguidelines-pro-bounds-pointer-arithmetic
#     A flyweight over a wire buffer is exactly a reinterpret_cast plus pointer
#     arithmetic. The safety comes from routing every one through a single
#     bounds-checked accessor, which is the design in docs/DESIGN.md section 1,
#     not from banning the cast.
#
#   modernize-use-trailing-return-type
#     Cosmetic, and inconsistent with the standard library spelling we match.
#
#   readability-identifier-length
#     Rejects `i` and `n`. TIGER_STYLE bans abbreviating *variable names*, not
#     conventional loop counters.
#
#   cppcoreguidelines-avoid-do-while
#     Fires on `do { ... } while (false)`, the idiom every multi-statement
#     macro in assert.hpp uses so a caller can write `DFR_ASSERT(x);` with a
#     trailing semicolon and have it parse as one statement everywhere,
#     including inside an unbraced `if`. The check cannot tell a macro-safety
#     wrapper from a real loop; nothing here is a real loop.
#
#   cppcoreguidelines-pro-type-vararg
#     Flags every std::fprintf/std::snprintf. Deliberate throughout: stderr
#     output on the assertion-failure path is not iostreams because it must
#     not allocate, and the trace writers use printf-family formatting for the
#     same reason quill and fmt give as a decompile-once-not-many argument
#     against <<-chains. The format strings are all compile-time literals.
#
#   cppcoreguidelines-missing-std-forward
#     Fires on every `Emit&&` parameter in chaos/injector.hpp, and forwarding
#     it would be the bug: the same callback is invoked once per packet
#     inside the function body, and std::forward on the first call would
#     legally move a callable out from under the second call. A forwarding
#     reference here is `auto&&` for cheap pass-by-reference to a caller's
#     lambda, not a forward-to-exactly-once constructor argument.
#
#   misc-include-cleaner
#     Wants every name's own header included directly, which fights the
#     project's own convention on purpose: "every wire protocol gets an
#     umbrella header" (checked by scripts/check-docs.sh) exists so a
#     consumer writes `#include <dfr/wire/moldudp64.hpp>` once and gets
#     everything, and internal headers rely on that umbrella rather than
#     re-including each leaf themselves. Enabling this check would mean
#     fighting the umbrella-header convention header by header rather than
#     enforcing it, which is backwards.

WarningsAsErrors: ''
HeaderFilterRegex: 'include/dfr/.*'
FormatStyle: file

CheckOptions:
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.ClassCase
    value: lower_case
  - key: readability-identifier-naming.StructCase
    value: lower_case
  - key: readability-identifier-naming.EnumCase
    value: lower_case
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.ParameterCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: '_'
  - key: readability-identifier-naming.ProtectedMemberSuffix
    value: '_'
  - key: readability-identifier-naming.GlobalConstantPrefix
    value: 'k'
  - key: readability-identifier-naming.ConstexprVariablePrefix
    value: 'k'
  - key: readability-identifier-naming.MacroDefinitionPrefix
    value: 'DFR_'
  - key: readability-identifier-naming.TemplateParameterCase
    value: CamelCase
  # LLVMFuzzerTestOneInput is libFuzzer's ABI, not a naming choice this project made; seven fuzz targets
  # define it identically and none of them may rename it.
  - key: readability-identifier-naming.FunctionIgnoredRegexp
    value: 'LLVMFuzzerTestOneInput'

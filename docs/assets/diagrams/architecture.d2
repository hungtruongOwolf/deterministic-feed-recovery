# The end-to-end data flow, rendered by scripts/regenerate-diagrams.sh into architecture.svg,
# which is what README.md actually embeds. Edit this file, not the SVG.
#
# Colors match viewer/src/ui/theme.css exactly (--page, --ink, --fault, --recovery), so a reader
# who has already seen the live run recognizes the same palette here.

vars: {
  d2-config: {
    layout-engine: dagre
    theme-overrides: {
      B1: "#92876f"
      B2: "#92876f"
      B3: "#e7e0d2"
      B4: "#e7e0d2"
      B5: "#f1ece1"
      B6: "#f1ece1"
      N1: "#1b1a17"
      N2: "#6d675c"
      N7: "#f1ece1"
      AA2: "#a8452c"
      AA4: "#f1ece1"
      AA5: "#f1ece1"
    }
  }
}

direction: down

classes: {
  fault-edge: {
    style: {
      stroke: "#a8452c"
      font-color: "#a8452c"
    }
  }
  recovery-edge: {
    style: {
      stroke: "#2b59d1"
      font-color: "#2b59d1"
    }
  }
}

venue: dfr::venue\n(the mock exchange) {
  publisher: iextp_publisher\nmarket data out
  retransmit: retransmit_facility\ncan refuse
  snapshot: snapshot_facility\nGlimpse
  session: order_session\nOUCH in
}

chaos: dfr::chaos {
  injector: injector<Target>\nseeded, protocol-aware
}

recovery: dfr::recovery {
  client: client<Clock>
  arbiter: arbiter\nA/B merge
  tracker: gap_tracker
  requester: requester
  replay: replay_buffer

  client -> arbiter
  client -> tracker
  client -> requester
  client -> replay
}

book: dfr::book {
  order_book: order_book<N>
}

trace: dfr::trace {
  recorder: recorder\nJSONL, one line per event
}

viewer: viewer/\nWASM + React

venue.publisher -> chaos.injector: "market data out\n(IEX-TP/MoldUDP64)"
chaos.injector -> recovery.client: "damaged stream" {class: fault-edge}
chaos.injector -> venue.session: "orders in, replies out\n(OUCH/SoupBinTCP)" {
  style.stroke: "#6d675c"
}

recovery.requester <-> venue.retransmit: "request  ↔  fill or refuse" {class: recovery-edge}
recovery.replay <-> venue.snapshot: "begin  ↔  levels  ↔  end" {class: recovery-edge}

recovery.client -> book.order_book: sequence-ordered
recovery.client -> trace.recorder: every decision
chaos.injector -> trace.recorder: every fault {class: fault-edge}
trace.recorder -> viewer: run.jsonl
